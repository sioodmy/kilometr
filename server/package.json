{
  "name": "kilometr-server",
  "version": "1.0.0",
  "private": true,
  "description": "Backend for Kilometr - Wrocław MPK transit routing, live tracking, and smart location caching",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc",
    "setup": "tsx scripts/setup-data.ts",
    "predev": "npm run setup --silent",
    "prestart": "npm run setup --silent"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "cors": "^2.8.5",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
