{
  "name": "kilometr-server",
  "version": "1.0.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "description": "Backend for Kilometr - Wrocław MPK transit routing, live tracking, and smart location caching",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc",
    "setup": "tsx scripts/setup-data.ts",
    "predev": "npm run setup --silent",
    "prestart": "npm run setup --silent",
    "test": "tsx scripts/check-server-routing.ts"
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.5",
    "tsx": "^4.19.3",
    "typescript": "^5.7.2"
  }
}
