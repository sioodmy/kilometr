# Domena wystawiana przez Caddy (jesli uzywasz profilu --profile caddy).
API_DOMAIN=api.kilometr.app

# Adres nasluchu na hoscie:
# - z Caddy lub Cloudflare Tunnel zostaw 127.0.0.1:8080
# - przy bezposrednim proxy Mikrusa (np. port z panelu) ustaw 0.0.0.0:PORT
KILOMETR_PUBLISH_ADDR=127.0.0.1:8080

# Interwaly pollingu w sekundach (dostosowane pod Mikrus 3.5: 4 GB RAM, 40 GB SSD).
KILOMETR_TIER1_POLL_SECS=12
KILOMETR_TIER2_POLL_SECS=35
KILOMETR_KP_POLL_SECS=55
KILOMETR_BOOST_POLL_SECS=4
KILOMETR_BOOST_TTL_SECS=75
KILOMETR_RAIL_POLL_SECS=35

# Rownoleglosc i timeouty kolektorow.
KILOMETR_COLLECTOR_CONCURRENCY=10
KILOMETR_HTTP_TIMEOUT_SECS=9
KILOMETR_ENABLE_COLLECTORS=true
KILOMETR_ENABLE_KP_COLLECTOR=true
KILOMETR_ENABLE_RAIL_COLLECTOR=true

# Retencja i limity bazy SQLite (ochrona dysku 40 GB).
KILOMETR_RAW_RETENTION_HOURS=48
KILOMETR_FLUSH_INTERVAL_SECS=20
KILOMETR_MAX_DB_SIZE_MB=4096

# Rate limiting per IP (token bucket).
KILOMETR_RATE_LIMIT_RPS=30
KILOMETR_RATE_LIMIT_BURST=90

# Logi JSON (true na produkcji, false dla wygodnego podgladu lokalnie).
KILOMETR_LOG_JSON=true
RUST_LOG=kilometr_api=info,tower_http=warn
