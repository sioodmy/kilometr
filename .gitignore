# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# build artifacts lokalnych modułów Expo (modules/*/android)
modules/*/android/build/
modules/*/android/.gradle/
modules/*/android/.cxx/
modules/*/ios/build/

# generowane dane backendu (pobierane automatycznie: `npm run setup`
# lub hooki predev/prestart w server/) — nigdy nie commitować
server/data/

# lokalne sekrety i artefakty pipeline'u rozkładów (klucz PDP API tylko
# w sekretach: `wrangler secret put` + GitHub Actions Secrets)
.env
cloudflare/dist/
cloudflare/.dev.vars
cloudflare/node_modules/
