# Kopia do .env (nigdy do gita; .env jest w .gitignore).
# Rozkłady pobierają się domyślnie z https://data.kilometr.app
# (adres wpieczony w src/services/gtfsConfig.ts), więc build APK działa
# bez tej zmiennej. Ustawiaj ją tylko do nadpisania, np. przy testach
# lokalnego Workera: EXPO_PUBLIC_TIMETABLE_URL=http://127.0.0.1:8787
EXPO_PUBLIC_TIMETABLE_URL=

# Backend realtime i analityki opóźnień (domyślnie https://api.kilometr.app).
# Do testów lokalnych ustaw np. http://127.0.0.1:8080
EXPO_PUBLIC_BACKEND_URL=
