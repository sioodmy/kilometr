<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/kw_bg" android:orientation="vertical" android:padding="12dp">
    <LinearLayout android:id="@+id/kw_dest_header" android:layout_width="match_parent" android:layout_height="48dp"
        android:layout_marginBottom="8dp" android:gravity="center_vertical" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical" android:paddingStart="4dp">
            <TextView android:id="@+id/kw_header" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end"
                android:text="@string/kw_dest_label" android:textColor="@color/kw_on_surface" android:textSize="18sp" />
            <TextView android:id="@+id/kw_origin" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:maxLines="1" android:ellipsize="end" android:textColor="@color/kw_on_surface_variant" android:textSize="12sp" />
        </LinearLayout>
        <ImageView android:id="@+id/kw_refresh_action" android:layout_width="48dp" android:layout_height="48dp"
            android:padding="12dp" android:layout_marginStart="8dp" android:background="@drawable/kw_search_surface"
            android:src="@drawable/kw_ic_refresh" android:tint="@color/kw_on_primary_container"
            android:focusable="true" android:contentDescription="@string/kw_refresh" />
    </LinearLayout>
    <LinearLayout android:id="@+id/kw_rows" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:orientation="vertical" android:visibility="gone" />
    <TextView android:id="@+id/kw_empty" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:gravity="center_vertical" android:text="@string/kw_open_app"
        android:textColor="@color/kw_on_surface" android:textSize="14sp" />
    <TextView android:id="@+id/kw_updated" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingStart="4dp" android:layout_marginTop="4dp" android:maxLines="1" android:ellipsize="end"
        android:textColor="@color/kw_on_surface_variant" android:textSize="11sp" />
</LinearLayout>
