<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/kw_bg">
    <LinearLayout android:id="@+id/kw_content" android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:padding="14dp">
        <LinearLayout android:id="@+id/kw_trip_header" android:layout_width="match_parent" android:layout_height="44dp"
            android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/kw_trip_kind" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="@string/kw_trip_label" android:textColor="@color/kw_on_surface_variant" android:maxLines="1" android:ellipsize="end" android:textSize="12sp" />
            <ImageView android:id="@+id/kw_search_action" android:layout_width="44dp" android:layout_height="44dp" android:padding="12dp"
                android:background="@drawable/kw_icon_bg" android:src="@drawable/kw_ic_search" android:tint="@color/kw_on_primary_container"
                android:contentDescription="@string/kw_search_hint" />
        </LinearLayout>
        <TextView android:id="@+id/kw_title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end"
            android:text="@string/kw_sample_work" android:textColor="@color/kw_on_surface" android:textSize="22sp" />
        <TextView android:id="@+id/kw_sub" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:maxLines="1" android:ellipsize="end" android:textSize="12sp" android:textColor="@color/kw_on_surface_variant" android:visibility="gone" />
        <TextView android:id="@+id/kw_phase" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:fontFamily="sans-serif-medium" android:includeFontPadding="false" android:maxLines="2" android:ellipsize="end"
            android:text="@string/kw_sample_phase" android:textColor="@color/kw_primary" android:textSize="24sp" />
        <LinearLayout android:id="@+id/kw_trip_times" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/kw_depart" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/kw_on_surface_variant" android:textSize="14sp" />
            <ImageView android:layout_width="16dp" android:layout_height="16dp" android:layout_marginHorizontal="8dp"
                android:src="@drawable/kw_ic_arrow" android:importantForAccessibility="no" android:tint="@color/kw_on_surface_variant" />
            <TextView android:id="@+id/kw_arrive" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:textColor="@color/kw_on_surface" android:textSize="14sp" />
            <TextView android:id="@+id/kw_status" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="8dp" android:maxLines="1" android:ellipsize="end" android:textColor="@color/kw_on_surface_variant" android:textSize="11sp" />
        </LinearLayout>
        <ProgressBar android:id="@+id/kw_progress" style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent" android:layout_height="8dp" android:layout_marginTop="10dp"
            android:max="1000" android:progress="400" android:progressDrawable="@drawable/kw_progress" />
        <LinearLayout android:id="@+id/kw_legs" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:gravity="center_vertical" android:orientation="horizontal" />
    </LinearLayout>
    <LinearLayout android:id="@+id/kw_empty" android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:gravity="center_vertical" android:padding="16dp" android:visibility="gone">
        <TextView android:id="@+id/kw_empty_title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/kw_trip_label" android:textSize="18sp" android:textColor="@color/kw_on_surface" />
        <TextView android:id="@+id/kw_empty_body" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/kw_open_app" android:textSize="13sp" android:textColor="@color/kw_on_surface_variant" />
    </LinearLayout>
</FrameLayout>
