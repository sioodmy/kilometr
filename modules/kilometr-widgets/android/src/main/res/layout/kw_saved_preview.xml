<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/kw_bg"
    android:orientation="vertical" android:padding="12dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:background="@drawable/kw_target_featured" android:gravity="center_vertical" android:orientation="horizontal" android:padding="12dp">
        <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/kw_ic_home"
            android:tint="@color/kw_on_primary_container" android:importantForAccessibility="no" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp"
            android:text="@string/kw_sample_place" android:textSize="16sp" android:fontFamily="sans-serif-medium" android:textColor="@color/kw_on_primary_container" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="8dp"
        android:background="@drawable/kw_place_secondary" android:gravity="center_vertical" android:orientation="horizontal" android:padding="12dp">
        <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/kw_ic_work"
            android:tint="@color/kw_on_secondary_container" android:importantForAccessibility="no" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp"
            android:text="@string/kw_sample_work" android:textSize="16sp" android:fontFamily="sans-serif-medium" android:textColor="@color/kw_on_secondary_container" />
    </LinearLayout>
</LinearLayout>
