<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/kw_next_surface" android:focusable="true">
    <LinearLayout android:id="@+id/kw_content" android:layout_width="match_parent" android:layout_height="match_parent"
        android:padding="16dp" android:orientation="vertical" android:visibility="gone">
        <LinearLayout android:id="@+id/kw_next_header" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/kw_next_label" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:fontFamily="sans-serif-medium" android:text="@string/kw_next_label"
                android:textSize="13sp" android:textColor="@color/kw_on_primary" android:maxLines="1" android:ellipsize="end" />
            <LinearLayout android:id="@+id/kw_badge_slot" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="4dp" android:orientation="horizontal" />
        </LinearLayout>
        <LinearLayout android:id="@+id/kw_countdown" android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal" android:baselineAligned="true">
            <TextView android:id="@+id/kw_big" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium" android:includeFontPadding="false" android:letterSpacing="-0.04"
                android:maxLines="1" android:textColor="@color/kw_on_primary" android:textSize="64sp" />
            <TextView android:id="@+id/kw_big_unit" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="5dp" android:text="@string/kw_min" android:textSize="18sp"
                android:textColor="@color/kw_on_primary" android:includeFontPadding="false" />
        </LinearLayout>
        <TextView android:id="@+id/kw_title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium" android:textColor="@color/kw_on_primary" android:textSize="16sp"
            android:includeFontPadding="false" android:maxLines="2" android:ellipsize="end" />
        <TextView android:id="@+id/kw_sub" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:textColor="@color/kw_on_primary" android:textSize="12sp"
            android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
    <LinearLayout android:id="@+id/kw_empty" android:layout_width="match_parent" android:layout_height="match_parent"
        android:padding="16dp" android:gravity="center_vertical" android:orientation="vertical">
        <ImageView android:id="@+id/kw_empty_icon" android:layout_width="32dp" android:layout_height="32dp"
            android:src="@drawable/kw_ic_walk" android:tint="@color/kw_on_primary" android:importantForAccessibility="no" />
        <TextView android:id="@+id/kw_empty_text" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="@string/kw_open_app" android:textColor="@color/kw_on_primary"
            android:textSize="14sp" />
    </LinearLayout>
</FrameLayout>
