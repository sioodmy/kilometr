<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Wszystko, czego Google Play mógłby się czepiać, żyje TYLKO w tym
       module: buildy prod i play- wyłączają moduł z autolinkingu
       (plugins/with-contributor.js), więc te wpisy w ogóle nie wchodzą do
       scalonego manifesu i Play nie wymusza deklaracji Location permissions.
       Buildy lokalne (nightly/dev/test) scalają je normalnie. -->

  <!-- Odblokowuje typ FGS `location` (Android 14+). Sam wpis nie daje żadnego
       dostępu do tła - o zgody runtime dba JS. -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

  <!-- Prompt „Zawsze": FGS typu location przeżywa wyłączenie ekranu także
       przy zgodzie „Podczas korzystania", ale zbieranie testowe wybiera
       wyraźną zgodę na dostęp w tle. Wpis celowo NIE jest w app.json -
       nie może trafić do AAB wysyłanych do Google Play. -->
  <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

  <application>
    <!-- Telemetria Contributor: 1 Hz GPS + akcelerometr do pliku JSONL. -->
    <service
        android:name="my.siood.kilometr.contributor.ContributorService"
        android:exported="false"
        android:foregroundServiceType="location" />
  </application>
</manifest>
